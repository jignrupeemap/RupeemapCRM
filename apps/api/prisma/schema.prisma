// Rupeemap Loan DSA CRM — database schema.
// Money: Decimal(15,2) rupees. Percentages: Decimal(6,3).
// Financial and history tables are append-only; important records use soft delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EXECUTIVE
  DSA
  TEAM_PARTNER
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
  SUSPENDED
  DEACTIVATED
}

enum CaseStatus {
  LOGIN
  SANCTION
  DISBURSED
  HANDOVER
  QUERY
  REJECT
  WITHDRAW
}

enum DisbursementType {
  PART
  PART_TO_FULL
  FULL
}

enum PayoutStatus {
  PENDING
  CONFIRMED
  PAID
  HOLD
}

/// Insurance commission Rupeemap receives from the insurer. Never shared with partners.
enum InsurancePayoutStatus {
  PENDING
  CONFIRMED
  RECEIVED
  HOLD
}

/// Payout clawback (PART 35–36).
enum RecoveryStatus {
  RECOVERY_PENDING
  BANK_RECOVERY_RECEIVED
  DEMAND_RAISED
  PARTIALLY_RECOVERED
  FULLY_RECOVERED
  DISPUTED
  WAIVED
  CLOSED
}

/// Raise Query (PART 45) and Need Assistance for a case (PART 46) share one ticket model.
enum TicketKind {
  QUERY
  ASSISTANCE
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum KycStatus {
  DOCUMENTS_PENDING
  UPLOADED
  UNDER_ADMIN_VERIFICATION
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

enum KycDocType {
  PAN
  AADHAAR
  CANCELLED_CHEQUE
  PHOTO
  GST_CERTIFICATE
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum MeasurementUnit {
  SQFT
  SQYD
  SBA
  CARPET
}

enum ChecklistItemStatus {
  PENDING
  RECEIVED
  NOT_APPLICABLE
}

enum OtpPurpose {
  ACTIVATE
  RESET_PASSWORD
}

// ───────────── Identity & access ─────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  name              String
  mobile            String     @unique
  username          String?    @unique
  email             String?
  passwordHash      String?    @map("password_hash")
  role              Role
  status            UserStatus @default(PENDING_ACTIVATION)
  mobileVerified    Boolean    @default(false) @map("mobile_verified")
  failedLogins      Int        @default(0) @map("failed_logins")
  lockedUntil       DateTime?  @map("locked_until")
  lastLoginAt       DateTime?  @map("last_login_at")
  activatedAt       DateTime?  @map("activated_at")
  /// Partner inactivity: when Admin/Executives were last alerted, and deactivation/reactivation marks.
  inactivityAlertedAt DateTime? @map("inactivity_alerted_at")
  deactivatedAt     DateTime?  @map("deactivated_at")
  deactivationReason String?   @map("deactivation_reason")
  reactivatedAt     DateTime?  @map("reactivated_at")
  createdById       String?    @map("created_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  createdBy         User?             @relation("UserCreatedBy", fields: [createdById], references: [id])
  created           User[]            @relation("UserCreatedBy")
  sessions          Session[]
  permissions       UserPermission[]
  passwordHistory   PasswordHistory[]
  dsaProfile        DsaPartner?
  memberships       TeamMembership[]  @relation("MemberUser")
  payoutRates       PayoutRate[]      @relation("RateUser")
  kyc               KycProfile?
  notifications     NotificationRecipient[]

  @@index([role, status])
  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash")
  userAgent   String?  @map("user_agent")
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model OtpVerification {
  id          String     @id @default(uuid()) @db.Uuid
  mobile      String
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([mobile, purpose, createdAt])
  @@map("otp_verifications")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Per-user grant or denial on top of role defaults (used for Executives).
model UserPermission {
  userId     String   @map("user_id") @db.Uuid
  permission String
  granted    Boolean
  setById    String   @map("set_by") @db.Uuid
  setAt      DateTime @default(now()) @map("set_at")
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, permission])
  @@map("user_permissions")
}

// ───────────── Organisation ─────────────

model DsaPartner {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  code        String   @unique // DSA-0001
  firmName    String?  @map("firm_name")
  gstApplicable Boolean @default(false) @map("gst_applicable")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])
  members     TeamMembership[]

  @@map("dsa_partners")
}

/// A Team Partner belongs to one DSA at a time; history kept via start/end dates.
model TeamMembership {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("team_partner_user_id") @db.Uuid
  dsaId         String    @map("dsa_id") @db.Uuid
  startedOn     DateTime  @default(now()) @map("started_on")
  endedOn       DateTime? @map("ended_on")
  endReason     String?   @map("end_reason")
  user          User      @relation("MemberUser", fields: [userId], references: [id])
  dsa           DsaPartner @relation(fields: [dsaId], references: [id])

  @@index([dsaId, endedOn])
  @@index([userId, endedOn])
  @@map("team_memberships")
}

model PayoutRate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  bankId        String?  @map("bank_id") @db.Uuid
  loanType      String?  @map("loan_type")
  percent       Decimal  @db.Decimal(6, 3)
  effectiveFrom DateTime @map("effective_from") @db.Date
  setById       String   @map("set_by") @db.Uuid
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation("RateUser", fields: [userId], references: [id])

  @@index([userId, effectiveFrom])
  @@map("payout_rates")
}

model KycProfile {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  status          KycStatus @default(DOCUMENTS_PENDING)
  gstApplicable   Boolean   @default(false) @map("gst_applicable")
  verifiedById    String?   @map("verified_by") @db.Uuid
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")
  submittedAt     DateTime? @map("submitted_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id])
  documents       KycDocument[]

  @@map("kyc_profiles")
}

/// One uploaded version of a KYC document. Re-uploads add a new version; nothing is overwritten.
model KycDocument {
  id             String     @id @default(uuid()) @db.Uuid
  kycProfileId   String     @map("kyc_profile_id") @db.Uuid
  type           KycDocType
  version        Int
  current        Boolean    @default(true)
  documentId     String     @unique @map("document_id") @db.Uuid
  uploadedById   String     @map("uploaded_by") @db.Uuid
  uploadedByName String     @map("uploaded_by_name")
  createdAt      DateTime   @default(now()) @map("created_at")
  profile        KycProfile @relation(fields: [kycProfileId], references: [id])
  document       Document   @relation(fields: [documentId], references: [id])

  @@unique([kycProfileId, type, version])
  @@index([kycProfileId, type, current])
  @@map("kyc_documents")
}

/// A private file. Stored encrypted outside the web root under a random key.
model Document {
  id           String    @id @default(uuid()) @db.Uuid
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mime         String
  sizeBytes    Int       @map("size_bytes")
  sha256       String
  encrypted    Boolean   @default(true)
  scanStatus   String    @default("UNSCANNED") @map("scan_status")
  uploadedById String    @map("uploaded_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")
  kyc          KycDocument?
  ticketMessage TicketMessage?
  notification Notification?
  slider       Slider?
  accessLogs   DocumentAccessLog[]

  @@map("documents")
}

model DocumentAccessLog {
  id         BigInt   @id @default(autoincrement())
  documentId String   @map("document_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ip         String?
  at         DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id])

  @@index([documentId, at])
  @@map("document_access_logs")
}

// ───────────── Master data ─────────────

model LoanType {
  code      String  @id
  name      String
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  @@map("loan_types")
}

model Bank {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  shortName String?  @map("short_name")
  isNbfc    Boolean  @default(false) @map("is_nbfc")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  bankers   BankerContact[]
  cases     LoanCase[]
  codes     BankCode[]
  sliders   Slider[]

  @@map("banks")
}

model BankerDesignation {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  level     Int     @default(0)
  bankers   BankerContact[]

  @@map("banker_designations")
}

model BankerContact {
  id            String   @id @default(uuid()) @db.Uuid
  bankId        String   @map("bank_id") @db.Uuid
  designationId String?  @map("designation_id") @db.Uuid
  name          String
  mobile        String?
  email         String?
  branch        String?
  city          String?
  region        String?
  product       String?
  active        Boolean  @default(true)
  /// Admin chooses which bankers DSA and Team Partners can see (Q9).
  visibleToPartners Boolean @default(true) @map("visible_to_partners")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  bank          Bank     @relation(fields: [bankId], references: [id])
  designation   BankerDesignation? @relation(fields: [designationId], references: [id])
  cases         LoanCase[]

  @@index([bankId])
  @@map("banker_contacts")
}

/// Bankwise codes (PART 41): DSA / connector codes per bank, product and location.
model BankCode {
  id                String    @id @default(uuid()) @db.Uuid
  bankId            String    @map("bank_id") @db.Uuid
  product           String
  code              String
  city              String?
  region            String?
  branch            String?
  effectiveFrom     DateTime? @map("effective_from") @db.Date
  expiresOn         DateTime? @map("expires_on") @db.Date
  active            Boolean   @default(true)
  remarks           String?
  visibleToPartners Boolean   @default(true) @map("visible_to_partners")
  createdById       String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  bank              Bank      @relation(fields: [bankId], references: [id])

  @@index([bankId, product])
  @@index([code])
  @@map("bank_codes")
}

model Project {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  nameNormalized  String          @unique @map("name_normalized")
  city            String
  locality        String          @default("")
  state           String
  reraNumber      String?         @unique @map("rera_number")
  projectType     ProjectType     @map("project_type")
  unitTypes       String[]        @map("unit_types")
  priceMin        Decimal?        @map("price_min") @db.Decimal(15, 2)
  priceMax        Decimal?        @map("price_max") @db.Decimal(15, 2)
  measurementUnit MeasurementUnit? @map("measurement_unit")
  active          Boolean         @default(true)
  createdById     String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  cases           LoanCase[]

  @@index([city])
  @@map("projects")
}

// ───────────── Cases ─────────────

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  mobile      String?
  pan         String?
  createdAt   DateTime @default(now()) @map("created_at")
  cases       LoanCase[]

  @@index([mobile])
  @@index([pan])
  @@map("customers")
}

model CaseCounter {
  year    Int @id
  lastSeq Int @default(0) @map("last_seq")

  @@map("case_counters")
}

model LoanCase {
  id                String      @id @default(uuid()) @db.Uuid
  caseNo            String      @unique @map("case_no")
  customerId        String      @map("customer_id") @db.Uuid
  coApplicantName   String?     @map("co_applicant_name")
  loanType          String      @map("loan_type")
  appliedAmount     Decimal     @map("applied_amount") @db.Decimal(15, 2)
  bankId            String      @map("bank_id") @db.Uuid
  projectId         String?     @map("project_id") @db.Uuid
  salesManagerId    String?     @map("sales_manager_id") @db.Uuid
  salesManagerName  String?     @map("sales_manager_name")
  salesManagerEmail String?     @map("sales_manager_email")
  status            CaseStatus  @default(LOGIN)
  statusBeforeQuery CaseStatus? @map("status_before_query")
  statusChangedAt   DateTime    @default(now()) @map("status_changed_at")
  sanctionAmount    Decimal?    @map("sanction_amount") @db.Decimal(15, 2)
  sanctionDate      DateTime?   @map("sanction_date")
  disbursedTotal    Decimal?    @map("disbursed_total") @db.Decimal(15, 2)
  disbursementType  DisbursementType? @map("disbursement_type")
  disbursedDate     DateTime?   @map("disbursed_date")
  handoverAmount    Decimal?    @map("handover_amount") @db.Decimal(15, 2)
  otcPddCleared     Boolean?    @map("otc_pdd_cleared")
  loanAccountNo     String?     @map("loan_account_no")
  handoverDate      DateTime?   @map("handover_date")
  dsaId             String      @map("dsa_id") @db.Uuid
  teamPartnerId     String?     @map("team_partner_id") @db.Uuid
  assignedExecutiveId String?   @map("assigned_executive_id") @db.Uuid
  createdById       String      @map("created_by") @db.Uuid
  createdRole       Role        @map("created_role")
  version           Int         @default(0)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  customer          Customer    @relation(fields: [customerId], references: [id])
  bank              Bank        @relation(fields: [bankId], references: [id])
  project           Project?    @relation(fields: [projectId], references: [id])
  salesManager      BankerContact? @relation(fields: [salesManagerId], references: [id])
  stageHistory      CaseStageHistory[]
  disbursements     CaseDisbursement[]
  remarks           CaseRemark[]
  payouts           Payout[]
  checklist         CaseChecklistItem[]
  insurance         InsurancePolicy[]
  tickets           Ticket[]

  @@index([dsaId, createdAt(sort: Desc)])
  @@index([teamPartnerId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([bankId])
  @@index([projectId])
  @@index([loanAccountNo])
  @@map("loan_cases")
}

model CaseStageHistory {
  id          String      @id @default(uuid()) @db.Uuid
  caseId      String      @map("case_id") @db.Uuid
  action      String
  fromStatus  CaseStatus? @map("from_status")
  toStatus    CaseStatus  @map("to_status")
  data        Json        @default("{}")
  remarks     String?
  changedById String      @map("changed_by") @db.Uuid
  changedByName String    @map("changed_by_name")
  changedRole Role        @map("changed_role")
  changedAt   DateTime    @default(now()) @map("changed_at")
  loanCase    LoanCase    @relation(fields: [caseId], references: [id])

  @@index([caseId, changedAt])
  @@map("case_stage_history")
}

model CaseDisbursement {
  id          String           @id @default(uuid()) @db.Uuid
  caseId      String           @map("case_id") @db.Uuid
  amount      Decimal          @db.Decimal(15, 2)
  type        DisbursementType
  disbursedOn DateTime         @default(now()) @map("disbursed_on")
  enteredById String           @map("entered_by") @db.Uuid
  loanCase    LoanCase         @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@map("case_disbursements")
}

model CaseRemark {
  id          String   @id @default(uuid()) @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  kind        String   // QUERY, QUERY_RESOLUTION, NOTE, BANK, CORRECTION
  body        String
  createdById String   @map("created_by") @db.Uuid
  createdByName String @map("created_by_name")
  createdRole Role     @map("created_role")
  createdAt   DateTime @default(now()) @map("created_at")
  loanCase    LoanCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
  @@map("case_remarks")
}

/// Document checklist template. Blank bank / loan type / project means "applies to all".
model ChecklistTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  bankId      String?   @map("bank_id") @db.Uuid
  loanType    String?   @map("loan_type")
  projectId   String?   @map("project_id") @db.Uuid
  product     String?
  active      Boolean   @default(true)
  createdById String    @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  items       ChecklistTemplateItem[]

  @@index([bankId, loanType])
  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id         String            @id @default(uuid()) @db.Uuid
  templateId String            @map("template_id") @db.Uuid
  name       String
  required   Boolean           @default(true)
  hint       String?
  sortOrder  Int               @default(0) @map("sort_order")
  active     Boolean           @default(true)
  template   ChecklistTemplate @relation(fields: [templateId], references: [id])
  caseItems  CaseChecklistItem[]

  @@index([templateId, sortOrder])
  @@map("checklist_template_items")
}

/// Progress of one checklist item on one case.
model CaseChecklistItem {
  id             String              @id @default(uuid()) @db.Uuid
  caseId         String              @map("case_id") @db.Uuid
  templateItemId String              @map("template_item_id") @db.Uuid
  status         ChecklistItemStatus @default(PENDING)
  remarks        String?
  updatedById    String              @map("updated_by") @db.Uuid
  updatedByName  String              @map("updated_by_name")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  loanCase       LoanCase            @relation(fields: [caseId], references: [id])
  templateItem   ChecklistTemplateItem @relation(fields: [templateItemId], references: [id])

  @@unique([caseId, templateItemId])
  @@map("case_checklist_items")
}

// ───────────── Finance ─────────────

model Payout {
  id                 String       @id @default(uuid()) @db.Uuid
  caseId             String       @map("case_id") @db.Uuid
  beneficiaryId      String       @map("beneficiary_user_id") @db.Uuid
  beneficiaryRole    Role         @map("beneficiary_role")
  baseAmount         Decimal      @map("base_amount") @db.Decimal(15, 2)
  percentSnapshot    Decimal      @map("percent_snapshot") @db.Decimal(6, 3)
  rateId             String?      @map("rate_id") @db.Uuid
  amount             Decimal      @db.Decimal(15, 2)
  status             PayoutStatus @default(PENDING)
  receivedFromBank   Boolean      @default(false) @map("received_from_bank")
  bankReceivedAmount Decimal?     @map("bank_received_amount") @db.Decimal(15, 2)
  bankReceivedOn     DateTime?    @map("bank_received_on")
  paidOn             DateTime?    @map("paid_on")
  paymentRef         String?      @map("payment_ref")
  remarks            String?
  version            Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  loanCase           LoanCase     @relation(fields: [caseId], references: [id])
  history            PayoutHistory[]
  recoveries         Recovery[]

  @@unique([caseId, beneficiaryId])
  @@index([status])
  @@index([beneficiaryId, status])
  @@map("payouts")
}

model PayoutHistory {
  id            String        @id @default(uuid()) @db.Uuid
  payoutId      String        @map("payout_id") @db.Uuid
  prevAmount    Decimal?      @map("prev_amount") @db.Decimal(15, 2)
  newAmount     Decimal?      @map("new_amount") @db.Decimal(15, 2)
  prevStatus    PayoutStatus? @map("prev_status")
  newStatus     PayoutStatus? @map("new_status")
  prevPercent   Decimal?      @map("prev_percent") @db.Decimal(6, 3)
  newPercent    Decimal?      @map("new_percent") @db.Decimal(6, 3)
  reason        String
  changedById   String        @map("changed_by") @db.Uuid
  changedByName String        @map("changed_by_name")
  changedAt     DateTime      @default(now()) @map("changed_at")
  payout        Payout        @relation(fields: [payoutId], references: [id])

  @@index([payoutId, changedAt])
  @@map("payout_history")
}

/// Insurance sold against a case (PART 34). Separate ledger from loan payouts.
model InsurancePolicy {
  id               String    @id @default(uuid()) @db.Uuid
  caseId           String    @map("case_id") @db.Uuid
  companyName      String    @map("company_name")
  productName      String?   @map("product_name")
  policyNumber     String?   @map("policy_number")
  insuranceAmount  Decimal   @map("insurance_amount") @db.Decimal(15, 2)
  premiumAmount    Decimal?  @map("premium_amount") @db.Decimal(15, 2)
  managerName      String?   @map("manager_name")
  managerMobile    String?   @map("manager_mobile")
  managerEmail     String?   @map("manager_email")
  remarks          String?
  createdById      String    @map("created_by") @db.Uuid
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  loanCase         LoanCase  @relation(fields: [caseId], references: [id])
  payout           InsurancePayout?

  @@index([caseId])
  @@map("insurance_policies")
}

/// Rupeemap's insurance commission for one policy. Rupeemap keeps 100%; it never feeds partner payouts.
model InsurancePayout {
  id          String                @id @default(uuid()) @db.Uuid
  policyId    String                @unique @map("policy_id") @db.Uuid
  amount      Decimal               @db.Decimal(15, 2)
  status      InsurancePayoutStatus @default(PENDING)
  receivedOn  DateTime?             @map("received_on")
  reference   String?
  remarks     String?
  version     Int                   @default(0)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  policy      InsurancePolicy       @relation(fields: [policyId], references: [id])
  history     InsurancePayoutHistory[]

  @@index([status])
  @@map("insurance_payouts")
}

model InsurancePayoutHistory {
  id            String                 @id @default(uuid()) @db.Uuid
  payoutId      String                 @map("payout_id") @db.Uuid
  prevAmount    Decimal?               @map("prev_amount") @db.Decimal(15, 2)
  newAmount     Decimal?               @map("new_amount") @db.Decimal(15, 2)
  prevStatus    InsurancePayoutStatus? @map("prev_status")
  newStatus     InsurancePayoutStatus? @map("new_status")
  reason        String
  changedById   String                 @map("changed_by") @db.Uuid
  changedByName String                 @map("changed_by_name")
  changedAt     DateTime               @default(now()) @map("changed_at")
  payout        InsurancePayout        @relation(fields: [payoutId], references: [id])

  @@index([payoutId, changedAt])
  @@map("insurance_payout_history")
}

/// Money the bank clawed back on a payout, and what Rupeemap recovers from the partner.
model Recovery {
  id             String         @id @default(uuid()) @db.Uuid
  payoutId       String         @map("payout_id") @db.Uuid
  caseId         String         @map("case_id") @db.Uuid
  beneficiaryId  String         @map("beneficiary_user_id") @db.Uuid
  recoveryAmount Decimal        @map("recovery_amount") @db.Decimal(15, 2)
  amountDemanded Decimal?       @map("amount_demanded") @db.Decimal(15, 2)
  amountReceived Decimal        @default(0) @map("amount_received") @db.Decimal(15, 2)
  status         RecoveryStatus @default(RECOVERY_PENDING)
  recoveryDate   DateTime       @map("recovery_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  bankRemarks    String?        @map("bank_remarks")
  reason         String
  createdById    String         @map("created_by") @db.Uuid
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  payout         Payout         @relation(fields: [payoutId], references: [id])
  receipts       RecoveryReceipt[]
  history        RecoveryHistory[]

  @@index([status, dueDate])
  @@index([beneficiaryId, status])
  @@index([caseId])
  @@map("recoveries")
}

model RecoveryReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  recoveryId  String   @map("recovery_id") @db.Uuid
  amount      Decimal  @db.Decimal(15, 2)
  receivedOn  DateTime @map("received_on") @db.Date
  reference   String?
  enteredById String   @map("entered_by") @db.Uuid
  enteredByName String @map("entered_by_name")
  createdAt   DateTime @default(now()) @map("created_at")
  recovery    Recovery @relation(fields: [recoveryId], references: [id])

  @@index([recoveryId])
  @@map("recovery_receipts")
}

model RecoveryHistory {
  id            String          @id @default(uuid()) @db.Uuid
  recoveryId    String          @map("recovery_id") @db.Uuid
  action        String
  prevStatus    RecoveryStatus? @map("prev_status")
  newStatus     RecoveryStatus  @map("new_status")
  data          Json            @default("{}")
  reason        String
  changedById   String          @map("changed_by") @db.Uuid
  changedByName String          @map("changed_by_name")
  changedAt     DateTime        @default(now()) @map("changed_at")
  recovery      Recovery        @relation(fields: [recoveryId], references: [id])

  @@index([recoveryId, changedAt])
  @@map("recovery_history")
}

// ───────────── Communication & content ─────────────

model Ticket {
  id           String         @id @default(uuid()) @db.Uuid
  ticketNo     String         @unique @map("ticket_no") // Q-2026-000001 / A-2026-000001
  kind         TicketKind
  category     String
  caseId       String?        @map("case_id") @db.Uuid
  subject      String
  priority     TicketPriority @default(NORMAL)
  status       TicketStatus   @default(OPEN)
  createdById  String         @map("created_by") @db.Uuid
  createdRole  Role           @map("created_role")
  /// The DSA whose team raised it, so a DSA can follow their Team Partners' tickets.
  dsaId        String?        @map("dsa_id") @db.Uuid
  assignedToId String?        @map("assigned_to") @db.Uuid
  version      Int            @default(0)
  lastActivityAt DateTime     @default(now()) @map("last_activity_at")
  resolvedAt   DateTime?      @map("resolved_at")
  closedAt     DateTime?      @map("closed_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  loanCase     LoanCase?      @relation(fields: [caseId], references: [id])
  messages     TicketMessage[]

  @@index([kind, status, lastActivityAt(sort: Desc)])
  @@index([createdById])
  @@index([dsaId])
  @@index([assignedToId, status])
  @@index([caseId])
  @@map("tickets")
}

/// Conversation on a ticket. Internal notes are visible to Rupeemap staff only.
model TicketMessage {
  id           String   @id @default(uuid()) @db.Uuid
  ticketId     String   @map("ticket_id") @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  authorName   String   @map("author_name")
  authorRole   Role     @map("author_role")
  body         String
  internal     Boolean  @default(false)
  event        String?  // STATUS, ASSIGNED: system lines in the thread
  documentId   String?  @unique @map("document_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  ticket       Ticket   @relation(fields: [ticketId], references: [id])
  document     Document? @relation(fields: [documentId], references: [id])

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketCounter {
  kind    TicketKind
  year    Int
  lastSeq Int @default(0) @map("last_seq")

  @@id([kind, year])
  @@map("ticket_counters")
}


model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  body        String
  priority    String   @default("NORMAL")
  audience    String   // ALL, DSA, TEAM_PARTNER, EXECUTIVE, USER, SYSTEM
  caseId      String?  @map("case_id") @db.Uuid
  startsAt    DateTime @default(now()) @map("starts_at")
  expiresAt   DateTime? @map("expires_at")
  sentById    String?  @map("sent_by") @db.Uuid
  documentId  String?  @unique @map("document_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  recipients  NotificationRecipient[]
  document    Document? @relation(fields: [documentId], references: [id])

  @@index([sentById, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationRecipient {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime?    @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

model Slider {
  id          String    @id @default(uuid()) @db.Uuid
  kind        String    // BANK_OFFER, PRODUCT_OFFER, CAMPAIGN, ANNOUNCEMENT
  title       String
  subtitle    String?
  mediaType   String    @default("IMAGE") @map("media_type") // IMAGE, VIDEO, NONE
  mediaUrl    String?   @map("media_url")
  theme       String    @default("emerald")
  ctaLabel    String?   @map("cta_label")
  ctaUrl      String?   @map("cta_url")
  startsAt    DateTime  @default(now()) @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  active      Boolean   @default(true)
  sortOrder   Int       @default(0) @map("sort_order")
  bankId      String?   @map("bank_id") @db.Uuid
  documentId  String?   @unique @map("document_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  document    Document? @relation(fields: [documentId], references: [id])
  bank        Bank?     @relation(fields: [bankId], references: [id])

  @@index([active, sortOrder])
  @@map("sliders")
}

// ───────────── System ─────────────

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  Role?    @map("actor_role")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  requestId  String?  @map("request_id")
  prevHash   String?  @map("prev_hash")
  hash       String
  at         DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, at])
  @@map("audit_logs")
}

/// One row per scheduled job per day, so a daily job runs once even with several API instances.
model JobRun {
  name       String
  runDate    DateTime  @map("run_date") @db.Date
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  result     Json?

  @@id([name, runDate])
  @@map("job_runs")
}

model IdempotencyKey {
  key        String   @id
  userId     String   @map("user_id") @db.Uuid
  route      String
  response   Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("idempotency_keys")
}
