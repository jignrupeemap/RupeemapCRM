{
  "name": "rupeemap-crm",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "dev:api": "pnpm --filter @rupeemap/api dev",
    "dev:web": "pnpm --filter @rupeemap/web dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @rupeemap/api prisma:migrate",
    "db:seed": "pnpm --filter @rupeemap/api seed",
    "db:local": "node scripts/local-db.mjs"
  },
  "devDependencies": {
    "embedded-postgres": "17.5.0-beta.15"
  }
}
